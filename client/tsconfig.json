{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@slash-ghost/shared": ["../shared/src"]
    }
  },
  "include": ["src/**/*", "index.html"]
}
